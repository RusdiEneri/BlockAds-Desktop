# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for Go code and source files
*.go text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.nsi text eol=lf
*.nsh text eol=lf
*.manifest text eol=lf

# Binary files
*.ico binary
*.png binary
*.woff2 binary
*.exe binary
*.zip binary
